# Copy to .env (gitignored) and fill in. Read by scripts/build-dmg.sh,
# build-linux.sh and build-windows.ps1.

# macOS signing + notarization (dist:mac)
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
# Optional — defaults to "Developer ID Application: Tim Murphy ($APPLE_TEAM_ID)"
# APPLE_SIGNING_IDENTITY=

# Updater key passphrase for ~/.tauri/sift.key (all platforms)
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
