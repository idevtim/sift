{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sift",
  "version": "1.1.0",
  "identifier": "com.sift.app",
  "build": {
    "beforeDevCommand": "cross-env TAURI_DEV_STRICT=1 npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "label": "main",
        "title": "Sift",
        "width": 1200,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 20 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright © 2026 Sift",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "See how much space you can safely get back.",
    "longDescription": "Sift is a friendly disk-space app. It finds what you can safely remove, and holds everything it removes for 30 days so you can change your mind.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/idevtim/sift/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCNTMzNzczRDNDNjg0OUEKUldTYWhNYlRjemRUMjZYZ2Q0b05OOFhuRUxEc2hod1VEYTdUQkZoSUc1aDA2dFh6OXB5S0pQWG0K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
